# ===================================================
# 🍵 CHOYXONA GAMES - SOZLAMALAR VA KALITLAR
# ===================================================

# 1. Telegram Bot Token (@BotFather dan olinadi)
# Masalan: 1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_BOT_TOKEN=

# 2. Gemini AI API Kaliti (Google AI Studio dan olinadi)
# Masalan: AIzaSy...
GEMINI_API_KEY=

# 3. Telegram Mini App Havolasi (HTTPS bo'lishi shart)
# Telegram orqali ochish uchun localtunnel yoki domeningiz manzilini yozing
# Masalan: https://choyxona-games.loca.lt yoki http://localhost:3000
MINI_APP_URL=http://localhost:3000

# 4. Server Porti
PORT=3001

# 5. Admin kaliti (/api/bot/configure uchun, tunnel.ts shu orqali bot havolasini yangilaydi)
# Bo'sh qoldirilsa endpoint butunlay o'chiq bo'ladi. Uzun tasodifiy qator yozing.
ADMIN_TOKEN=

# 6. Ma'lumotlar papkasi (foydalanuvchilar, reyting). Standart: server/data
# DATA_DIR=/var/lib/choyxona
